#!/usr/bin/python3
from __future__ import annotations

import os
import subprocess
import sys
import wave
from pathlib import Path

NODE = os.environ.get("OPENCLAW_VOICE_NODE", "openclaw-voice-node")
REMOTE_PYTHON = os.environ.get(
    "OPENCLAW_VOICE_PYTHON",
    "~/.local/share/openclaw-voice/venv/bin/python",
)
REMOTE_SCRIPT = os.environ.get(
    "OPENCLAW_VOICE_SCRIPT",
    "~/.local/share/openclaw-voice/voice_assistant.py",
)
REMOTE_ENV = [
    "ONNX_PROVIDER=CUDAExecutionProvider",
    "HF_HUB_OFFLINE=1",
    "HF_HUB_DISABLE_TELEMETRY=1",
]


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: openclaw-kokoro-remote-tts OUTPUT_PATH TEXT", file=sys.stderr)
        return 2

    os.umask(0o077)
    output_path = Path(sys.argv[1])
    text = sys.argv[2]
    command = [
        "/usr/bin/ssh",
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=8",
        "-o",
        "StrictHostKeyChecking=yes",
        NODE,
        "/usr/bin/env",
        *REMOTE_ENV,
        REMOTE_PYTHON,
        REMOTE_SCRIPT,
        "--tts-stdin",
    ]

    try:
        with output_path.open("wb") as output:
            result = subprocess.run(
                command,
                input=text.encode("utf-8"),
                stdout=output,
                stderr=subprocess.PIPE,
                timeout=115,
                check=False,
            )
    except subprocess.TimeoutExpired:
        output_path.unlink(missing_ok=True)
        print("Remote Kokoro TTS timed out", file=sys.stderr)
        return 1

    if result.returncode != 0:
        output_path.unlink(missing_ok=True)
        diagnostic = result.stderr.decode("utf-8", errors="replace")[-4000:]
        print(f"Remote Kokoro TTS failed: {diagnostic}", file=sys.stderr)
        return result.returncode

    if output_path.stat().st_size > 50 * 1024 * 1024:
        output_path.unlink(missing_ok=True)
        print("Remote Kokoro TTS output exceeded 50 MiB", file=sys.stderr)
        return 1

    try:
        with wave.open(str(output_path), "rb") as audio:
            if audio.getnchannels() != 1 or audio.getsampwidth() != 2:
                raise RuntimeError("Kokoro TTS returned an unexpected WAV format")
    except (EOFError, wave.Error, OSError) as error:
        output_path.unlink(missing_ok=True)
        print(f"Remote Kokoro TTS returned invalid WAV audio: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
