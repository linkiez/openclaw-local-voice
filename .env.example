# Adjust these values for the local microphone and available CPU resources.
VOICE_MIC_SOURCE=default
VOICE_RMS_THRESHOLD=250
VOICE_INPUT_GAIN=6.0
VOICE_WHISPER_MODEL=small

# Optional local paths. The default TTS worker uses the project virtualenv.
# OPENCLAW_TTS_PYTHON=/path/to/openclaw-local-voice/venv/bin/python

# If needed, set the installed OpenClaw CLI executable.
# OPENCLAW_COMMAND=/path/to/openclaw

# Optional: preserve an existing conversation by setting its session key.
# OPENCLAW_SESSION_KEY=agent:voice:explicit:openclaw-local-voice

# Optional: change the local wake bell sound.
# VOICE_WAKE_BELL_SOUND=/usr/share/sounds/freedesktop/stereo/bell.oga
